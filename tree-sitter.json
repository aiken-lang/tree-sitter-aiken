{
  "grammars": [
    {
      "name": "aiken",
      "camelCase": "aiken",
      "scope": "source.aiken",
      "path": ".",
      "file-types": ["ak"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^aiken$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Aiken grammar for tree-sitter",
    "authors": [
      {
        "name": "rvcas"
      }
    ],
    "links": {
      "repository": "https://github.com/aiken-lang/tree-sitter-aiken"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
